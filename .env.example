# Cấu hình Turso Cloud SQLite (Dành cho Vercel & Production)
# Lấy từ Dashboard tại https://turso.tech sau khi tạo database miễn phí:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DB_MODE=turso
# Khi chạy cục bộ trên máy tính (Local Development):
# Nếu không điền 2 biến trên, ứng dụng sẽ tự động dùng file SQLite cục bộ tại: data/stock.db
PORT=3001

# Cấu hình Google OAuth (Tùy chọn)
# Tạo OAuth 2.0 Client ID tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
