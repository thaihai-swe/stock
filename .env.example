# ==============================================================================
# 🌟 STOCK PORTFOLIO MANAGER & ENTERPRISE VALUATION ENGINE — ENV CONFIGURATION
# ==============================================================================
# Sao chép tệp này thành .env và điền các giá trị tương ứng:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CỔNG SERVER (SERVER PORT)
# ------------------------------------------------------------------------------
PORT=3001

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DATABASE: TURSO CLOUD SQLITE & LOCAL SQLITE
# ------------------------------------------------------------------------------
# Chế độ lưu trữ DB_MODE:
# - local: Sử dụng file SQLite cục bộ tại `data/stock.db` (Offline 100%, độc lập)
# - turso: Kết nối Turso Cloud SQLite (Dành cho Vercel Production hoặc đồng bộ cloud)
DB_MODE=local

# Thông tin kết nối Turso Cloud (Tạo database miễn phí tại https://turso.tech):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH GOOGLE OAUTH 2.0 (XÁC THỰC NGƯỜI DÙNG)
# ------------------------------------------------------------------------------
# Lấy Client ID tại Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Cần điền cả 2 biến nếu muốn bật tính năng đăng nhập Google:
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH HỆ SINH THÁI AI COPILOT & LLM ENGINE
# ------------------------------------------------------------------------------
# Lựa chọn Nhà cung cấp AI (AI_PROVIDER):
# - auto: Tự động phát hiện (Ưu tiên Gemini nếu có key -> OpenAI -> Heuristic Offline)
# - gemini: Sử dụng Google Gemini
# - openai: Sử dụng OpenAI Standard API (Hỗ trợ DeepSeek, Groq, OpenRouter, Ollama)
# - heuristic: Luôn sử dụng bộ động cơ heuristic định lượng tích hợp sẵn (0ms, 0 chi phí)
AI_PROVIDER=auto

# Mô hình AI chung (nếu không chỉ định riêng):
AI_MODEL=gemini-1.5-flash

# Tham số tạo sinh:
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# --- [A] GOOGLE GEMINI ---
# Lấy API key miễn phí tại Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Các mô hình Google Gemini được hỗ trợ chính thức:
# - gemini-1.5-flash: Tốc độ cao, tiết kiệm token, ngữ cảnh 1M token (Khuyến nghị mặc định)
# - gemini-1.5-pro: Khả năng suy luận vượt trội, chuyên sâu định giá BCTC & báo cáo vĩ mô (2M token)
# - gemini-2.0-flash: Thế hệ mới nhất tốc độ cực nhanh, phản hồi tức thì
# - gemini-2.0-flash-lite: Bản siêu nhẹ tối ưu quota miễn phí
GEMINI_MODEL=gemini-1.5-flash

# --- [B] OPENAI STANDARD API (Hoặc DeepSeek / Groq / OpenRouter / Ollama) ---
# Tương thích chuẩn endpoint POST /v1/chat/completions:
AI_PROVIDER=openai
OPENAI_API_KEY=sk-05c6d470f1fc5b3a-4huo2d-1ae6565c
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=super-vip


# Gợi ý Base URL cho các nhà cung cấp phổ biến:
# - DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com/v1         | OPENAI_MODEL=deepseek-chat
# - Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1      | OPENAI_MODEL=llama-3.3-70b-versatile
# - OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1       | OPENAI_MODEL=deepseek/deepseek-chat
# - Ollama Local: OPENAI_BASE_URL=http://localhost:11434/v1         | OPENAI_MODEL=llama3.1
